# ==============================================================================
# CreatorBoost Bot - Environment Configuration
# ==============================================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Google YouTube Data API v3 Key (NO OAuth required)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=AIzaSyD-YourOfficialYouTubeApiKeyHere

# Telegram User IDs of Admins (comma-separated integers)
ADMIN_IDS=7854748403,123456789

# Database URL
# For SQLite (default local): sqlite+aiosqlite:///creatorboost.db
# For PostgreSQL (production): postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///creatorboost.db

# AdsGram Monetization Integration (Optional - leave empty for mock)
# Get from: https://adsgram.ai
ADSGRAM_BLOCK_ID=block-12345

# Admin UPI ID for Manual Payment Deposits
ADMIN_UPI_ID=creatorboost@upi

# Default Platform Settings
DEFAULT_LANGUAGE=en
WATCH_TIMER_SECONDS=45
PLATFORM_FEE_PERCENT=10
SPONSORED_MSG_INTERVAL=3
DAILY_WATCH_AD_LIMIT=5
WATCH_AD_COINS=15
DAILY_BONUS_BASE=10
REFERRAL_BONUS=100
REFERRAL_TASK_THRESHOLD=3
WELCOME_BONUS_COINS=50
